# Caddy config for the hosted public demo (docker-compose.demo.yml).
#
# With the default DEMO_DOMAIN (demo.firemaster.io), Caddy fetches and renews the
# TLS certificate automatically — no certbot, no cron. DNS for the domain must
# point at the host before first boot.
#
# Local smoke test (plain HTTP, no ACME):
#   DEMO_DOMAIN=":80" CADDY_HTTP_PORT=8080 docker compose -f docker-compose.demo.yml up
#   -> http://localhost:8080

{$DEMO_DOMAIN:demo.firemaster.io} {
	encode gzip

	# JSON access log for funnel metrics. Written under /logs, which the demo
	# compose bind-mounts to ./caddy/logs on the host — bind mounts survive the
	# periodic `down -v` reset, so the log outlives container recreation.
	log {
		output file /logs/access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 8760h
		}
		format json
	}

	# Zip-download counter: the firemaster.io landing page points its "Download
	# the kit" button here so each download lands in OUR access log (Vercel has
	# no per-file stats we can query). Just a redirect back to the real file.
	handle /get/firemaster-starter.zip {
		redir https://firemaster.io/firemaster-starter.zip 302
	}

	# API -> FastAPI backend (routes already live under /api, no rewrite needed)
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Everything else -> the static SPA
	handle {
		reverse_proxy frontend:8080
	}
}
