# Production frontend image: 2-stage build -> static site on nginx.
# Used by docker-compose.demo.yml (the hosted public demo) and by anyone
# self-hosting FIREMaster behind a real reverse proxy instead of the Vite
# dev server. API calls are relative /api, so the proxy in front decides
# where the backend lives — nothing is baked in at build time.
FROM node:22.22-slim@sha256:e21fc383b50d5347dc7a9f1cae45b8f4e2f0d39f7ade28e4eef7d2934522b752 AS build

WORKDIR /app

# package-lock.json is mandatory; npm ci reproduces it byte for byte.
COPY package.json package-lock.json ./
RUN npm ci

# Build the static bundle (tsc -b && vite build)
COPY . .
RUN npm run build

FROM nginx:1.30.4-alpine3.24@sha256:dc5069ad14f19660b141b21236140b91656bf89bbc3e2417c70ae650cd66104c

# Alpine fixes published after the pinned digest was cut.
RUN apk upgrade --no-cache

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
RUN touch /run/nginx.pid \
    && chown -R nginx:nginx /etc/nginx/conf.d /usr/share/nginx/html /var/cache/nginx \
    && chown nginx:nginx /run/nginx.pid

USER nginx
EXPOSE 8080
